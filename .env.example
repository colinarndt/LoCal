# Copy to .env and fill in, or let `python -m social_calendar.cli init` write it.
# Never commit the result — .env and .env.local are gitignored.

# DeepSeek API key — caption gating, flyer vision, website fallback, and suggestions.
# Get one at https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=

# Optional development override. Production defaults to deepseek-flash.
# DEEPSEEK_MODEL=deepseek-flash

# Apify API token — fetches Instagram posts.
# Get one at https://console.apify.com/settings/integrations
APIFY_TOKEN=

# Hosted PWA only. Leave auth mode unset for the local/macOS application.
# Cloudflare Access must also restrict the application to approved emails.
# LOCAL_CALENDAR_AUTH_MODE=cloudflare
# CLOUDFLARE_ACCESS_TEAM_DOMAIN=https://your-team.cloudflareaccess.com
# CLOUDFLARE_ACCESS_AUD=

# Optional identity shown to code paths that need a user in local mode.
# LOCAL_CALENDAR_LOCAL_EMAIL=you@example.com

# City, radius, and timezone are deliberately NOT here. They are non-secret,
# live in config.json, and are editable at /settings in the web UI.
