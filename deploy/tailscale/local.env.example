# /etc/local-calendar/local.env — single-user install served over Tailscale.
# Provider keys stay in $LOCAL_CALENDAR_HOME/.env (mode 600), not here.
LOCAL_CALENDAR_HOME=/srv/local-calendar
PLAYWRIGHT_BROWSERS_PATH=/opt/local-calendar/ms-playwright

# Performer alerts via ntfy (optional). Without these, alerts stay queued.
# Use a token for a write-only ntfy user; keep this file root-only (chmod 600).
# NTFY_URL=http://127.0.0.1:2586/optiplex
# NTFY_TOKEN=tk_...
