[Unit]
Description=LoCal web application (single user, served by tailscale serve)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=local-calendar
Group=local-calendar
WorkingDirectory=/opt/local-calendar
EnvironmentFile=/etc/local-calendar/local.env
# Loopback only: `tailscale serve` is the sole way in. Binding 0.0.0.0 would
# expose the unauthenticated UI to the whole LAN.
ExecStart=/opt/local-calendar/.venv/bin/gunicorn \
    --workers 1 \
    --threads 8 \
    --timeout 120 \
    --bind 127.0.0.1:8730 \
    --access-logfile - \
    --error-logfile - \
    local_calendar.web:app
Restart=on-failure
RestartSec=5
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/local-calendar
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
