# Secrets
.env
.env.local

# Local config written by `cli init` -- city, radius, timezone are per-install.
config.json

# Per-machine tool settings, not project config.
.claude/

.venv/
__pycache__/
*.pyc
.pytest_cache/
.DS_Store
*.egg-info/

# PyInstaller output. The .app and the .dmg are release artifacts -- attach them
# to a tagged release rather than carrying 26MB of rebuildable binary per commit.
build/
dist/

# Compiled by make_icon.py, which is the real source for the artwork. Run it
# before `pyinstaller` on a fresh clone -- make_dmg.sh already does.
AppIcon.icns
AppIcon.iconset/

# Scraped content and model output — regenerable, and not ours to redistribute.
# This is the line SPEC §11 draws: caching flyers and captions locally is fine
# for a private single-user app and is NOT fine in a public repo.
spike/posts/
spike/results/
data/
